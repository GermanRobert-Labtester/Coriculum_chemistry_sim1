    },
    {
      "id": "N22-C06",
      "label": "OPEN-FOR-N23-N24",
      "owner": "N22",
      "topic": "Pašnovērtējuma kritēriji skaitliskajos un grafa tipos",
      "roadmap_label": "Ceļa karte prasa, lai katram tipam būtu datu ceļš saviem kritērijiem",
      "contract_label": "Bankas instances Q02, Q09, Q10, Q11 un Q12 deklarē self-assessed kritēriju, bet N04 numeric un graph datu klases nepieļauj teksta lauku",
      "resolution_lv": "N22 reģistrē tikai tos laukus, ko datu klase atļauj, un nepievieno slepenu teksta lauku. Šiem tipiem pašnovērtējuma kritērijam nav datu pamata, tāpēc N23/N24 ir jāizlemj, vai kritēriju atmest vai pieņemt kā pending bez ievades. Konflikts paliek atklāts un nav noklusēts."
    },
    {
      "id": "N22-C07",
      "label": "DOCUMENTED-AND-ACCEPTED",
      "owner": "N22",
      "topic": "Sesijas datu līguma tips metodei",
      "roadmap_label": "Ceļa karte A.1.1 prasa lauka līmeņa ARIA nosaukumus visiem tipiem",
      "contract_label": "exam_policy payload_contracts.method prasa tikai variant; Q03/Q05/Q13/Q15/Q16/Q17 papildu lauki sesijas slānī nav tipizēti",
      "resolution_lv": "Sesijas līgums paliek strukturāls, un reģistra lauku veidnes ir vienīgā tipizācijas autoritāte. Q03_template, Q04_vector, Q05_rows, Q12_read, Q15_text un Q16_text ir reģistra deklarēti varianti ārpus exam_policy named_variants četrinieka; tie neapstrīd sesijas līgumu, jo tas papildu laukus neaizliedz."
    },
    {
      "id": "N22-C08",
      "label": "DOCUMENTED-AND-ACCEPTED",
      "owner": "N22",
      "topic": "Artefakta kopapjoma pārbudžets",
      "roadmap_label": "Ceļa karte 1.3 sadaļa deklarē 700–1 400 KiB joslu; N21 noteica izpildāmo griestu 1 440 KiB",
      "contract_label": "N22 ievades slānis palielina artefaktu līdz 1 522 087 B (1 486,4 KiB): reakcijas tipu reģistra sala 34 179 B kanoniski, terminoloģijas salas pieaugums +47 549 B un trīs dūmu vektori",
      "resolution_lv": "Griests pārlikts uz mērījuma pamata (1 504 KiB), kas pierakstīts tools/byte_budget.py vēsturē; deklarētā josla paliek redzama, un galīgo inline/lazy-load/pārbudžeta lēmumu pieņem N31. N22 ievades moduļi (225 423 B) tiek piegādāti no src/ un nav inline'oti; izpildāmais runtime JS 270 014 B paliek zem 264 KiB griesta."
    }
