{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 1,
  "id": "question-schema",
  "title": "RSU MedChem Colloquium 1 Practice Question Schema (N04)",
  "status": "frozen-contract-for-N20-N22-N24-N05",
  "citations": {
    "type_catalogue": "docs/QUESTION_TYPES_AND_VARIANTS.md#1-question-type-catalogue",
    "blueprint": "docs/SIMULATION_BLUEPRINT.json#constraints",
    "coverage_island": "data/coverage.json",
    "conventions_island": "data/conventions.json",
    "families_spec": "docs/QUESTION_FAMILIES.json"
  },
  "island_contract": {
    "island_id": "sim-bank",
    "root_required": [
      "island_id",
      "schema_version",
      "bank_version",
      "status",
      "questions"
    ],
    "island_id_value": "sim-bank"
  },
  "authoring_workflow_contract": {
    "source_location": "data/bank/",
    "only_authoring_gate": "tools/validate_bank.py",
    "build_freeze": "tools/build.py embeds validated source records into #sim-bank inside output/simulator.html",
    "island_immutable": true,
    "emergency_fix_rule": "Any emergency fix to a shipped #sim-bank island MUST be applied to the data/bank/ source files, revalidated through tools/validate_bank.py, and rebuilt through tools/build.py. Direct island surgery in output/simulator.html is forbidden."
  },
  "required_types_per_form": [
    "Q02",
    "Q04",
    "Q10",
    "Q11",
    "Q12",
    "Q13",
    "Q15"
  ],
  "discriminator_rule": "Every question instance MUST declare payload_class explicitly, and payload_class MUST equal types[type_id].payload_class. This resolves structural overlap between payload classes (for example numeric vs option_select both carrying string fields).",
  "cross_island_bindings": {
    "outcome_ids": {
      "owner": "N02",
      "source": "data/coverage.json",
      "rule": "Every outcome_id in outcome_ids must exist in data/coverage.json outcomes[].id."
    },
    "tolerance_class": {
      "owner": "N03",
      "source": "data/conventions.json",
      "rule": "Every numeric payload tolerance_class must exist in data/conventions.json tolerances.quantity_classes[].id. No numeric tolerance thresholds are duplicated in question instances."
    },
    "misconception_signatures": {
      "owner": "N09",
      "source": "stub-until-N09",
      "pattern": "^MC-[1-7][A-D]-[0-9]{2}$",
      "rule": "Temporary N09 stub binding: each misconception signature must match ^MC-[1-7][A-D]-[0-9]{2}$ until N09's misconception registry lands."
    }
  },
  "shared_core": {
    "required": [
      "question_id",
      "schema_version",
      "bank_version",
      "family_id",
      "variant_id",
      "seed",
      "topic",
      "outcome_ids",
      "type_id",
      "type_ids",
      "difficulty",
      "time_minutes",
      "stem_lv",
      "feedback_lv",
      "misconception_signatures",
      "source_refs",
      "givens",
      "payload_class",
      "payload",
      "rubric",
      "review"
    ],
    "properties": {
      "question_id": {
        "type": "string",
        "pattern": "^COL1-[1-7]-[A-Z0-9-]+$"
      },
      "schema_version": {
        "type": "integer",
        "minimum": 1
      },
      "bank_version": {
        "type": "string",
        "minLength": 1
      },
      "family_id": {
        "type": "string",
        "pattern": "^FAM-[1-7][A-D]$"
      },
      "variant_id": {
        "type": "string",
        "enum": ["A", "B", "C", "D"]
      },
      "seed": {
        "type": "string",
        "minLength": 1
      },
      "topic": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7
      },
      "outcome_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^P[1-7]-[0-9]{2}$"
        }
      },
      "type_id": {
        "type": "string",
        "enum": [
          "Q01", "Q02", "Q03", "Q04", "Q05", "Q06",
          "Q07", "Q08", "Q09", "Q10", "Q11", "Q12",
          "Q13", "Q14", "Q15", "Q16", "Q17", "Q18"
        ]
      },
      "type_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "Q01", "Q02", "Q03", "Q04", "Q05", "Q06",
            "Q07", "Q08", "Q09", "Q10", "Q11", "Q12",
            "Q13", "Q14", "Q15", "Q16", "Q17", "Q18"
          ]
        }
      },
      "difficulty": {
        "type": "string",
        "enum": ["foundational", "application", "transfer"]
      },
      "time_minutes": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "stem_lv": {
        "type": "string",
        "minLength": 1
      },
      "feedback_lv": {
        "type": "object",
        "required": ["correct", "incorrect"],
        "properties": {
          "correct": { "type": "string", "minLength": 1 },
          "incorrect": { "type": "string", "minLength": 1 },
          "hint": { "type": "string" }
        },
        "additionalProperties": false
      },
      "misconception_signatures": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^MC-[1-7][A-D]-[0-9]{2}$"
        }
      },
      "source_refs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["path", "sha256", "locator", "claim_status"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "locator": { "type": "string", "minLength": 1 },
            "claim_status": {
              "type": "string",
              "enum": ["text-verified", "proposal-explicit-givens", "unverified"]
            }
          },
          "additionalProperties": false
        }
      },
      "givens": {
        "type": "object"
      },
      "payload_class": {
        "type": "string",
        "enum": ["numeric", "option_select", "ordering", "matching", "graph", "method"]
      },
      "payload": {
        "type": "object"
      },
      "rubric": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["criterion_id", "points", "grading", "engine_binding", "depends_on", "carry_forward"],
          "properties": {
            "criterion_id": { "type": "string", "minLength": 1 },
            "points": { "type": "number", "exclusiveMinimum": 0 },
            "grading": {
              "type": "string",
              "enum": ["auto", "self", "human", "mixed"]
            },
            "engine_binding": {
              "type": "string",
              "enum": ["N17-numeric", "N18-symbolic", "N19-method", "self-assessed", "human-review"]
            },
            "depends_on": {
              "type": "array",
              "items": { "type": "string" }
            },
            "carry_forward": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "review": {
        "type": "object",
        "required": ["content", "source", "calculation", "accessibility"],
        "properties": {
          "content": { "type": "string", "enum": ["pending", "passed", "blocked"] },
          "source": { "type": "string", "enum": ["pending", "passed", "blocked"] },
          "calculation": { "type": "string", "enum": ["pending", "passed", "blocked"] },
          "accessibility": { "type": "string", "enum": ["pending", "passed", "blocked"] }
        },
        "additionalProperties": false
      },
      "extensions": {
        "type": "object",
        "required": ["extension_type", "data"],
        "properties": {
          "extension_type": { "type": "string", "minLength": 1 },
          "data": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "payload_classes": {
    "numeric": {
      "description": "Numeric calculation or scale reading with unit, sig figs, and N03 tolerance_class reference.",
      "required": ["expected_value", "unit", "tolerance_class", "sig_figs", "display_lv", "input_fields"],
      "properties": {
        "expected_value": { "type": "number" },
        "unit": { "type": "string" },
        "tolerance_class": { "type": "string", "minLength": 1 },
        "sig_figs": { "type": "integer", "minimum": 1 },
        "display_lv": { "type": "string", "minLength": 1 },
        "input_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field_id", "label_lv", "kind"],
            "properties": {
              "field_id": { "type": "string", "minLength": 1 },
              "label_lv": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["number", "unit", "text"] }
            },
            "additionalProperties": false
          }
        },
        "substeps": { "type": "array" },
        "scale_spec": { "type": "object" }
      },
      "additionalProperties": false
    },
    "option_select": {
      "description": "Structured option/category selection with explicit distractor slots and optional justification.",
      "required": ["options", "correct_ids", "distractors", "requires_justification"],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["option_id", "text_lv"],
            "properties": {
              "option_id": { "type": "string", "minLength": 1 },
              "text_lv": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "correct_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "distractors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["option_id", "rationale_lv"],
            "properties": {
              "option_id": { "type": "string", "minLength": 1 },
              "rationale_lv": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "requires_justification": { "type": "boolean" },
        "justification_prompt_lv": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ordering": {
      "description": "Ordered procedure or sequence contract with partial-order support.",
      "required": ["items", "correct_order", "explanation_prompt_lv"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["item_id", "text_lv"],
            "properties": {
              "item_id": { "type": "string", "minLength": 1 },
              "text_lv": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "correct_order": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "partial_order_rules": { "type": "array" },
        "explanation_prompt_lv": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "matching": {
      "description": "Pair-matching contract with keyboard-accessible select controls (no position-based key).",
      "required": ["left_items", "right_items", "correct_pairs"],
      "properties": {
        "left_items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "text_lv"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text_lv": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "right_items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "text_lv"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text_lv": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "correct_pairs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["left_id", "right_id"],
            "properties": {
              "left_id": { "type": "string", "minLength": 1 },
              "right_id": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "graph": {
      "description": "Graph construction or interpretation payload with axes, units, data points, and model parameters.",
      "required": ["mode", "x_axis", "y_axis", "points", "target_readout"],
      "properties": {
        "mode": { "type": "string", "enum": ["construct", "interpret"] },
        "x_axis": {
          "type": "object",
          "required": ["label_lv", "unit"],
          "properties": {
            "label_lv": { "type": "string", "minLength": 1 },
            "unit": { "type": "string" }
          },
          "additionalProperties": false
        },
        "y_axis": {
          "type": "object",
          "required": ["label_lv", "unit"],
          "properties": {
            "label_lv": { "type": "string", "minLength": 1 },
            "unit": { "type": "string" }
          },
          "additionalProperties": false
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "target_readout": {
          "type": "object",
          "required": ["quantity", "expected_value", "unit", "tolerance_class"],
          "properties": {
            "quantity": { "type": "string", "minLength": 1 },
            "expected_value": { "type": "number" },
            "unit": { "type": "string" },
            "tolerance_class": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "method": {
      "description": "Structured step, equation/formula, error-repair, or explanation slots.",
      "required": ["steps", "explanation_prompt_lv", "expected_summary_lv"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["step_id", "prompt_lv", "expected"],
            "properties": {
              "step_id": { "type": "string", "minLength": 1 },
              "prompt_lv": { "type": "string", "minLength": 1 },
              "expected": {}
            },
            "additionalProperties": false
          }
        },
        "explanation_prompt_lv": { "type": "string", "minLength": 1 },
        "expected_summary_lv": { "type": "string", "minLength": 1 },
        "species_list": {
          "type": "array",
          "items": { "type": "string" }
        },
        "medium": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "types": {
    "Q01": {
      "id": "Q01",
      "name_lv": "Skaitliska atbilde ar mērvienību",
      "payload_class": "numeric",
      "required_per_form": false,
      "engine": "N17-numeric",
      "blueprint_ref": "docs/QUESTION_TYPES_AND_VARIANTS.md#Q01"
    },
    "Q02": {
      "id": "Q02",
      "name_lv": "Daudzsoļu aprēķins",
