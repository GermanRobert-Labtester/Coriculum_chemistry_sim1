        {
          "layer": 3,
          "kind": "rule_citation",
          "text_lv": "Q = m·c·ΔT, bet reakcijas entalpija ΔrH ir ar pretēju zīmi šķīduma uzņemtajam siltumam (C04).",
          "citation": {"kind": "concept", "id": "P4-11"}
        },
        {
          "layer": 4,
          "kind": "first_step",
          "text_lv": "Aprēķini ΔT un siltuma daudzumu J, tad izdali ar izreaģējušo vielas daudzumu molos.",
          "citation": {"kind": "concept", "id": "P4-04"}
        }
      ]
    },
    {
