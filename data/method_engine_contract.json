      ],
      "error_classes": [
        "NONE",
        "BLANK_RESPONSE",
        "WRONG_ORDER"
      ],
      "rule_lv": "Nākamais solis tiek atzīts, ja viņa id ir pieņemamajā kopumā. Deklarētais klucējošais solis atgriež savu paraksturu, nezināms id atgriež uzveduma noklusējuma paraksturu."
    },
    "self_assessment": {
