  "owner": "N19",
  "status": "frozen-contract-for-N20-N22-N23-N28",
  "title_lv": "Metodisko kartīšu un trīs nestatisko dzinēju līgums",
  "purpose_lv": "Viena deklarēta saskarne: kārtīgo soļu, atbilstību pāru un secības pabeigšanas atbildes tiek vērtētas strukturāli, kā tiek paziņots paraksturs un kur ir robeža starp automātiski pārbaudāmo un pašnovērtējamo.",
  "epistemic_note_lv": "Dzinējs pats nesauc ne saturu, ne atzīmes. Visi soļu identifikatori, pāru identitātes un pieņemamie soļi nāk no deklarētā specifikācijas; visi atgriezeniskās saites teksti nāk no #sim-terms un no kartīšu soļu piezīmēm. Neveido oficiālu eksāmenu, nepiešķir vērtējumu un neaizstāj docētāju.",
  "handoff": {
    "from": [
      "N02",
      "N04",
      "N05",
      "N10",
      "N16"
    ],
    "to": [
      "N20",
      "N22",
      "N23",
      "N28",
      "N36"
    ],
    "n09_gap_notice": "N09 misconceptions reģistrs šajā darba telpā vēl nav izpildīts. Paraksturi lieto N04 deklarēto stub-parakstu MC-[1-7][A-D]-[0-9]{2} un atbilst esošiem #sim-golden-vectors vektoriem; katrs paraksturs atzīmēts reģistrā ar savu izcelsmi. N09 izpildot, jāpārbauda reģistra saiste, nevis dzinēja loģika."
  },
  "no_keyword_rule_verbatim_lv": "Grading never reads the learner's wording. A step, a pair and a next step are recognised only by their declared identity (an id). The engines contain no similarity, no keyword list, no stemming and no case folding; a submission that uses a synonym of the correct step text is graded wrong because the text is not an id.",
  "identity_rule_verbatim_lv": "Vertīkums ir id, nevis teksts. Kartītes soļa id, pāra kreisā un labā id un secības pieņemamā soļa id ir vienīgie salīdzināšanas objekti.",
  "partial_order_rule_verbatim_lv": "Kārtība ir punktēta: katrs soļa slots ir vai nu pareizs, vai nepareizs. Nav gandrīz pareizu kārtību un nav daļēji pareizu secību. Brīvās kārtības grupas dalībnieki savā starpā tiek pieņemti abā secībā, jo meistars šo secību neierobežo.",
  "engines": {
    "ordering": {
      "id": "N19-ordering",
      "submission_shape": "{\"order\": [step_id, ...]}",
      "spec_fields": [
        "item_ids",
        "correct_order",
        "free_groups",
        "step_meta",
        "rubric"
      ],
      "diagnostic_unit": "position",
      "diagnostic_statuses": [
