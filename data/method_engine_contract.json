        "free_order_equivalent",
        "misplaced",
        "unknown_step",
        "missing_step"
      ],
      "error_classes": [
        "NONE",
        "BLANK_RESPONSE",
        "WRONG_ORDER"
      ],
      "rule_lv": "Katra pozīcija tiek salīdzināta ar deklarēto kārtību. Divi soļi no vienas brīvās kārtības grupas uzskatīti par savstarpēji pieņemamiem. Katrs nepareizais slots atgriež soļa paraksturu un piezīmi, tāpēc diagnoze ir precīza, nevis vispārēja."
    },
    "matching": {
      "id": "N19-matching",
      "submission_shape": "{\"pairs\": [{\"left_id\": ..., \"right_id\": ...}, ...]}",
      "spec_fields": [
        "left_items",
        "right_items",
        "correct_pairs",
        "pair_meta",
        "rubric"
      ],
      "diagnostic_unit": "pair",
      "diagnostic_statuses": [
        "correct",
        "wrong_pair",
        "unmatched",
        "repeated_left",
        "repeated_right",
        "unknown_left",
        "unknown_right"
      ],
      "error_classes": [
        "NONE",
        "BLANK_RESPONSE",
        "WRONG_PAIRING"
      ],
      "rule_lv": "Pāri tiek salīdzināti pa kreisā id. Kreisā id atkārtošanās atzīmē visus tās pārus kā nepareizus; neuzliktais kreisais id atzīmēts kā neiedots; nezināms id atzīmēts kā nezināms."
    },
    "sequence": {
      "id": "N19-sequence",
      "submission_shape": "{\"next_step_id\": step_id}",
      "spec_fields": [
        "acceptance_step_ids",
