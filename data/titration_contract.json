    "redox_potential": {
      "curve_function_class": "titration_redox_potential",
      "equivalence_volume": "V_eq = C_analyte_mol_l * V_analyte_ml / (electrons_titrant * C_titrant_mol_l)",
      "before_equivalence": "E = E0_analyte + nernst_slope*log10(x/(1-x))",
      "at_equivalence": "E_eq = (E0_analyte + n*E0_titrant)/(n+1)",
      "after_equivalence": "E = E0_titrant + (nernst_slope/n)*log10(y*[H+]^8)",
      "params": ["C_analyte_mol_l", "V_analyte_ml", "C_titrant_mol_l", "V_max_ml", "E0_analyte_v", "E0_titrant_v", "electrons_titrant", "nernst_slope_v", "h_plus_mol_l", "initial_oxidized_fraction"]
    }
  },
