{
  "schema_version": 1,
  "island_id": "sim-engines",
  "artifact": "engine-taxonomy",
  "owner": "N17",
  "status": "frozen-contract-for-N20-N22-N23",
  "title_lv": "Aprēķinu dzinēju un četru kļūdu klašu līgums",
  "purpose_lv": "Viena aprēķinu autoritāte: dimensiju ķēde, masas un molu bilance, četru kļūdu klašu secība un atsauce uz N10 terminu salu.",
  "epistemic_note": "Dzinējs pats nesauc ne saturu, ne atzīmes. Visi koeficienti, masas, konstantes un tolerances nāk no #sim-conventions; visi atgriezeniskās saites teksti nāk no #sim-terms. Pieļaujamības un domēna robežas ir PROPOSED mācību politika ar norādītām konvenciju atsaucēm, ne oficiālas eksāmena prasības.",
  "handoff": {
    "from": ["N03", "N05", "N09", "N10", "N12", "N13", "N14", "N15"],
    "to": ["N18", "N20", "N22", "N23", "N28", "N36"],
    "n09_gap_notice": "N09 reģistrs šajā darba telpā vēl nav izpildīts. Līdz tam taksonomija lieto N04 deklarēto stub-parakstu MC-[1-7][A-D]-[0-9]{2} un atsauces uz jau lietotajiem parametriem #sim-golden-vectors; katra klase kartē uz esošu parametru un uz terminu salā esošu atsauksmes tekstu. N09 izpildot, tikai šis kartējums jāpārbauda, nevis dzinēja loģika."
  },
  "conventions_consumption": {
    "island": "sim-conventions",
    "paths": [
      "unit_system.base_units",
      "unit_system.conversions",
      "unit_system.chains",
      "atomic_masses",
      "compound_molar_masses",
      "constants",
      "tolerances.quantity_classes",
      "rounding",
      "concentration_bases",
      "percentage_basis",
      "density"
    ],
    "no_local_constants_rule": "Quantity engine source must not declare a numeric literal equal to any atomic mass, compound molar mass, constant value or declared conversion factor from #sim-conventions. Build-time AST/token scan enforces the rule by name.",
    "unit_grammar_source": "sim-terms#/unit_grammar"
  },
  "quantity_engine": {
    "python_twin": "tools/quantity_engine.py",
    "runtime_module": "src/quantity-engine.js",
    "api": [
      "Quantity.parse(raw, unit, sig_figs) -> Quantity",
      "Quantity.convert(to_unit, conventions) -> Quantity",
      "add(a, b) -> Quantity",
      "multiply(a, b) -> Quantity",
      "divide(a, b) -> Quantity",
      "dimension_gate(quantities, expected_dimension) -> ledger",
      "grade(instance, submission) -> verdict",
      "check_conservation(record) -> conservation_verdict",
      "classify(case) -> class_verdict",
      "feedback(error_class) -> resolved term string"
    ],
    "dimension_gate_rule_verbatim": "Katra operācija reģistrē savu vienību algebru. Aprēķins, kura ievadu un izvadu dimensijas nesakrīt, neveido skaitlisku rezultātu un tiek klasificēts kā DIMENSIONAL_INCONSISTENCY pirms jebkuras konversijas.",
    "v04_exclusion_rule_verbatim": "Masa↔tilpums ir iespējams tikai ar deklarētu ρ. Tiešs mg→L, g→mL vai mg→g→L pārrēķins bez ρ ir dimensiju kļūda un tiek bloķēts; dzinējs nekad nepiešķir fiktīvu koeficientu."
  },
  "conservation": {
    "rules": [
      {
        "id": "mass_in_equals_mass_out",
        "statement_lv": "Izejvielu masa pēc transformācijas parādās produktu masā; kopējā masa saglabājas.",
        "tolerance_source": "tolerances.quantity_classes[id=mass].absolute.value",
        "conventions_ref": "CIT-C1-AL",
        "error_class": "PHYSICALLY_IMPLAUSIBLE"
      },
      {
        "id": "moles_by_stoichiometry",
        "statement_lv": "Molārā bilance izmanto deklarētos stehiometriskos koeficientus: n_out = n_in · ν_out / ν_in.",
        "tolerance_source": "rounding.rule",
        "relative_tolerance": 0.001,
        "conventions_ref": "CIT-C3-C",
        "error_class": "PHYSICALLY_IMPLAUSIBLE"
      }
    ],
    "verdicts": ["BALANCED", "IMBALANCED"],
    "imbalance_signature": "MC-1C-01"
  },
  "error_taxonomy": {
    "classes": [
      {
        "id": "UNREADABLE_INPUT",
        "rank": 1,
        "name_lv": "Neizlasāms ievads",
        "definition_lv": "Ievada gramatika (skaitlis vai N10 vienību gramatika) neizdodas pirms dimensiju pārbaudes.",
        "signature": "MC-2B-02",
        "feedback_key": "feedback.error.unreadable",
        "conventions_ref": "CIT-C2-UNITS",
        "n05_error_classes": ["UNREADABLE_INPUT", "BLANK_RESPONSE"]
      },
      {
        "id": "DIMENSIONAL_INCONSISTENCY",
        "rank": 2,
        "name_lv": "Dimensiju neatbilstība",
        "definition_lv": "Ievads ir izlasāms, bet vienību algebra neslēdzas vai stars ir bloķēts (V-04 ieskaitot).",
        "signature": "MC-3B-01",
        "feedback_key": "feedback.error.dimensional",
        "conventions_ref": "CIT-C2-DENSITY-UNITS",
        "n05_error_classes": ["DIMENSIONAL_INCONSISTENCY"]
      },
      {
        "id": "PHYSICALLY_IMPLAUSIBLE",
        "rank": 3,
        "name_lv": "Fiziski neiespējams dimensiju ietvaros",
        "definition_lv": "Vienības ir korektas, bet lielums pārkāpj deklarēto fiziskās jēgas robežu no konvenciju atsauces datiem.",
        "signature": "MC-3A-02",
        "feedback_key": "feedback.error.implausible",
        "conventions_ref": "CIT-C3-PERCENT",
        "n05_error_classes": ["OUT_OF_TOLERANCE", "UNLABELED_PERCENT_BASIS", "SIG_FIG_MISMATCH"]
      },
      {
        "id": "OUT_OF_DOMAIN",
        "rank": 4,
        "name_lv": "Sintaktiski derīgs, bet ārpus domēna",
        "definition_lv": "Ievads ir izlasāms, dimensijās korekts un fiziski iespējams, bet atrodas ārpus uzdevuma deklarētā apgabala.",
        "signature": "MC-7B-02",
        "feedback_key": "feedback.error.out_of_domain",
        "conventions_ref": "CIT-C7-NOEXTRAP",
        "n05_error_classes": ["OUT_OF_DOMAIN_EXTRAPOLATION", "WRONG_OPTION_SELECTION", "WRONG_ORDER", "WRONG_PAIRING"]
      }
    ],
    "precedence_rule_verbatim": "Ja viens ievads atbilst vairākām klasēm, izvēlas mazāko kārtas numuru: 1 (neizlasāms) pirms 2 (dimensijas) pirms 3 (fiziskā jēga) pirms 4 (domēns). Pirmā atrastā klase aptur turpmāku pārbaudi; katrs gadījums iegūst tieši vienu klasi.",
    "boundary_rule_verbatim": "Robeža ir iekļaujoša: vērtība, kas vienāda ar deklarēto robežu, nav ārpus domēna. Tas pats attiecas uz N14 span edge rule un N15 no-extrapolation inheritance.",
    "fallback": {
      "signature": "MC-2B-02",
      "feedback_key": "feedback.fallback_notice",
      "rule_lv": "Nezināms, bet izlasāms skaitlisks ievads klasificējas kā 1. klase ar godīgu mācību ceļu, nevis klusu noklusējumu."
    },
    "feedback_source_island": "sim-terms"
  },
  "plausibility_rules": [
    {
      "id": "nonnegative_concentration",
      "dimensions": ["concentration_mass", "concentration_amount"],
      "min": 0,
      "inclusive": true,
      "source": "concentration_bases.bases",
      "conventions_ref": "CIT-C3-C",
      "label": "PROPOSED training-policy bound derived from the declared concentration definition"
    },
    {
      "id": "nonnegative_mass",
      "dimensions": ["mass"],
      "min": 0,
      "inclusive": true,
      "source": "unit_system.base_units.mass",
      "conventions_ref": "CIT-C2-UNITS",
      "label": "PROPOSED training-policy bound derived from the declared mass unit"
    },
    {
      "id": "positive_volume",
      "dimensions": ["volume"],
      "min": 0,
      "inclusive": false,
      "source": "tolerances.master_grounded_instrument_uncertainty[id=burette_reading]",
      "conventions_ref": "CIT-C2-BURETTE-READ",
      "label": "PROPOSED training-policy bound derived from the declared volume reading rule"
    },
    {
      "id": "ph_domain",
      "dimensions": ["ph"],
      "min": 0,
      "max": 14,
      "inclusive": true,
      "source": "titration.model_vocabulary.strong_acid_strong_base.initial_ph",
      "conventions_ref": "CIT-C6-EPRIME",
      "label": "PROPOSED training-policy domain bound cited to the conventions pH convention"
    },
    {
      "id": "percent_basis_required",
      "dimensions": ["dimensionless"],
      "unit_token": "%",
      "requires_explicit_basis": true,
      "source": "percentage_basis.unlabeled_percent",
      "conventions_ref": "CIT-C3-PERCENT",
      "label": "master-grounded withholding rule"
    },
    {
      "id": "yield_bound",
      "dimensions": ["dimensionless"],
      "min": 0,
      "max": 100,
      "inclusive": true,
      "source": "percentage_basis.bases",
      "conventions_ref": "CIT-C3-PERCENT",
      "label": "PROPOSED training-policy bound derived from the percentage definition"
    }
  ],
  "domain_rules": [
    {
      "id": "calibration_span",
      "source_contract": "data/calibration_contract.json",
      "rule_id": "N15-NOEXTRAP-01",
      "conventions_ref": "CIT-C7-NOEXTRAP",
      "verbatim": "Neviena taisne, nolasījums vai atzīmēta vērtība netiek renderēta ārpus datu deklarētā diapazona."
